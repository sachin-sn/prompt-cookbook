{
  "name": "prompt-cookbook",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, benchmarked, searchable prompts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "prompt:new": "tsx scripts/new-prompt.ts",
    "schema:export": "tsx scripts/export-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
